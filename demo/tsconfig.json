{
  // Type-checks the demo's browser code against the app it stands in for:
  //   npx tsc -p demo
  // Not part of the app's own build (tsc -b), which never sees the demo.
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.demo.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "types": ["vite/client"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "paths": { "@/*": ["../src/*"] }
  },
  "include": ["client"]
}
