{
  // Tests get the same rules as the app plus Node's types — some of them read
  // fixtures off disk (src/lib/geo/ats.test.ts loads the shipped survey table,
  // deliberately, so a missing or truncated asset fails the suite).
  //
  // Kept separate from tsconfig.app.json rather than just adding "node" there:
  // app code must NOT typecheck against Node globals, or a stray process.env
  // in a component compiles cleanly and breaks in the browser.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src"],
  "exclude": []
}
