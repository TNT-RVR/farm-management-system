# Copy to .env for running the app on your own computer (npm run dev).
# Values come from your Supabase project: Project Settings → API.
# The anon key is safe in the browser. The service_role key is NOT: it
# belongs only in Netlify's environment variables, never in this file.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
